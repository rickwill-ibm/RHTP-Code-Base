# ============================================================================
# CMS-0057-F integration — server-only env (no NEXT_PUBLIC_ prefix = never sent
# to the browser). This is the template the install scripts copy to .env.local.
#
# DEMO MODE vs PRODUCTION:
#   Demo    → NEXT_PUBLIC_USE_MOCK_DATA=true  + ALLOW_DEV_MOCK_AUTH=true
#             No Docker, no FHIR server, no Policy Engine. Run: npm run dev
#   Tier A  → NEXT_PUBLIC_USE_MOCK_DATA=false + ALLOW_DEV_MOCK_AUTH=true
#             Containerized FHIR + MySQL backbone. Run: bash install/install.sh
#   Tier B  → NEXT_PUBLIC_USE_MOCK_DATA=false + ALLOW_DEV_MOCK_AUTH=false
#             Full WSO2 + Ballerina production stack.
# ============================================================================

# --- Master data source switch -----------------------------------------------
# DEMO: true | Tier A/B: false
NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Tier A: integrated dev backbone (containerized FHIR + MySQL) ------------
# Point the BFF at the HAPI FHIR container (port 8090 avoids the :8080 clash).
FHIR_GATEWAY_BASE=http://localhost:8090/fhir
# Dev auth: allow a local session when WSO2 is not configured. MUST be false in prod.
ALLOW_DEV_MOCK_AUTH=true
# Session cookie encryption (32+ random chars). Generate a real one for any shared use.
SESSION_SECRET=dev-only-change-me-please-32chars-min

# --- Prior Authorization — /api/dtr/evaluate ---------------------------------
# DEMO mode (USE_MOCK_DATA=true): Maria's CPT 72148 scenario served inline, no
#   external service required.
# Tier A/B live mode: set POLICY_ENGINE_URL to the running Policy Engine.
#   Start it with: cd PA-Standalone-SmartApp && npm run dev:policy-engine
#   (or via docker compose in PA-Standalone-SmartApp/infra/docker-compose.yml)
# POLICY_ENGINE_URL=http://localhost:8083

# --- Tier B: full CMS-0057-F backbone (WSO2 + Ballerina) ---------------------
# When the reference stack is up, set these and flip ALLOW_DEV_MOCK_AUTH=false.
# FHIR_GATEWAY_BASE=https://localhost:8243/<fhir-context>/fhir/r4
# CDS_GATEWAY_BASE=https://localhost:8243/<cds-context>
# BULK_GATEWAY_BASE=https://localhost:8243/<bulk-context>/bulk
# WSO2_AUTHORIZE_URL=https://localhost:9453/oauth2/authorize
# WSO2_TOKEN_URL=https://localhost:9453/oauth2/token
# WSO2_CLIENT_ID=<from the APIM app>
# WSO2_CLIENT_SECRET=<from the APIM app — secret>
# WSO2_REDIRECT_URI=http://localhost:4029/api/auth/callback
# WSO2_SCOPE=openid fhirUser launch/patient patient/*.read offline_access

# --- Prior-auth webhook (Tier B) --------------------------------------------
WEBHOOK_SHARED_SECRET=dev-webhook-secret-change-me

# --- Feature flags (browser-readable; NOT secrets) --------------------------
NEXT_PUBLIC_FLAG_PATIENT_ACCESS=true
NEXT_PUBLIC_FLAG_PROVIDER_ACCESS=true
NEXT_PUBLIC_FLAG_PAYER_TO_PAYER=true
NEXT_PUBLIC_FLAG_PRIOR_AUTH=true
NEXT_PUBLIC_FLAG_AI_DTR=false
