              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "§4 — Reviewer Work Queue (SLA timers)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/work-queue",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "description": "CMS-0057-F §422.122(b)(1). Work items grouped by disposition with 72h expedited / 168h standard SLA due-dates and breach flags."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 or 401', () => {",
              "  pm.expect([200, 401]).to.include(pm.response.code);",
              "});",
              "pm.test('returns items array when 200', () => {",
              "  if (pm.response.code === 200) {",
