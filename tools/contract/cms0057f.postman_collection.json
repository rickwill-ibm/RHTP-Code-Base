      ]
    },
    {
      "name": "§4 — Evidence Record (CDex audit spine)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/evidence/ev-{{patientId}}-{{cptCode}}-{{providerNpi}}",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "description": "CMS-0057-F §4 (Da Vinci CDex). Fetches the Coverage Determination Record — auditable chain linking every PA decision to its source data for patient {{patientId}}, CPT {{cptCode}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200, 404 or 401', () => {",
              "  pm.expect([200, 404, 401]).to.include(pm.response.code);",
              "});",
              "pm.test('returns evidence record when 200', () => {",
              "  if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.satisfy(b => b.id || b.evidenceId || b.patientId);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Infrastructure — Network Adequacy (patient state)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/network-adequacy?state={{patientState}}",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "description": "MA §422.116 · Medicaid §438.68 · 2024 CMS Access Rule. Returns adequacy metrics and prioritised gaps for {{patientState}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns adequacy data', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.satisfy(b => b.gaps || b.metrics || b.state || Array.isArray(b));",
              "});"
            ]
          }
        }
