# ============================================================================
# PA Standalone SMART App — Environment Configuration
#
# HOW TO USE:
#   cp .env.example .env.local
#   Edit .env.local with your settings
#   npm run dev   (starts on :4032 — separate from RHTP on :4029)
#
# .env.local is gitignored — this file IS committed.
# ============================================================================

# ============================================================================
# MASTER DATA SOURCE SWITCH
# true  = fully mocked (no FHIR server needed — default for local dev)
# false = live HAPI FHIR server required
# ============================================================================
NEXT_PUBLIC_USE_MOCK_DATA=true

# ============================================================================
# FHIR SERVER (same HAPI instance as RHTP when running live)
# ============================================================================
NEXT_PUBLIC_FHIR_BASE_URL=http://localhost:8080/fhir
NEXT_PUBLIC_FHIR_TIMEOUT=30000

# ============================================================================
# SMART ON FHIR (OAuth 2.0)
# Redirect URI must be registered in the EHR authorization server
# ============================================================================
NEXT_PUBLIC_SMART_CLIENT_ID=pa-smart-app
NEXT_PUBLIC_SMART_REDIRECT_URI=http://localhost:4032/app
NEXT_PUBLIC_SMART_SCOPE=launch launch/patient launch/encounter patient/*.read openid fhirUser offline_access

# ============================================================================
# CDS HOOKS — Prior Auth Service endpoint
# ============================================================================
NEXT_PUBLIC_CDS_HOOKS_ENDPOINT=http://localhost:8080/cds-services
NEXT_PUBLIC_CDS_HOOKS_TIMEOUT=10000

# ============================================================================
# PAYER FHIR ENDPOINT (mock in dev; real payer URL in prod)
# ============================================================================
NEXT_PUBLIC_PAYER_FHIR_BASE_URL=https://payer-fhir.example-payer.com/R4

# ============================================================================
# FEATURE FLAGS
# ============================================================================
NEXT_PUBLIC_ENABLE_EDI_FALLBACK=true
NEXT_PUBLIC_ENABLE_BATCH_WORKLIST=true
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=true
